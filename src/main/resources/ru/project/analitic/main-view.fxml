<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.Tooltip?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="ru.project.analitic.controller.MainController"
      spacing="10"
      style="-fx-background-color: #f4f4f4;"
      prefWidth="700" prefHeight="550">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

        <StackPane VBox.vgrow="NEVER" alignment="CENTER">
            <Label text="УОДУУПиПДН ГУ МВД России по Нижегородской области"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </StackPane>

    <MenuBar VBox.vgrow="NEVER">
        <Menu text="Справка">
            <MenuItem text="О программе" onAction="#showAbout"/>
        </Menu>
    </MenuBar>

    <Button text="1. Поиск дубликатов/уникальных значений в двух файлах"
            onAction="#duplicateInTwoFiles"
            maxWidth="Infinity"
            prefHeight="40"
            style="-fx-font-size: 24px;">
        <tooltip>
            <Tooltip text="Поиск дубликатов в двух файлах"/>
        </tooltip>
    </Button>

    <Button text="2. Поиск дубликатов в одном файле"
            onAction="#duplicateInOneFiles"
            maxWidth="Infinity"
            prefHeight="40"
            style="-fx-font-size: 24px;">
        <tooltip>
            <Tooltip text="Поиск дублей лиц в файле"/>
        </tooltip>
    </Button>

    <Button text="3. Сверка ч.1 ст. 116.1"
            onAction="#sverka116PathOne"
            maxWidth="Infinity"
            prefHeight="40"
            style="-fx-font-size: 24px;">
        <tooltip>
            <Tooltip text="Сверка на факты повторносити совершения 6.1.1"/>
        </tooltip>
    </Button>
</VBox>
